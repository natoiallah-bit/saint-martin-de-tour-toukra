# Variables à créer dans Railway (onglet Variables du service). Ne pas mettre ce fichier en ligne rempli.
APP_NAME="Complexe Scolaire Saint Martin de Tour"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:A_GENERER_VOIR_GUIDE
APP_URL=https://VOTRE-DOMAINE.up.railway.app
APP_LOCALE=fr
APP_TIMEZONE=Africa/Ndjamena
TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_SECURE_COOKIE=true

# Base SQLite sur le volume monté dans /data (simple, suffisant pour une école)
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
DB_JOURNAL_MODE=WAL
DB_BUSY_TIMEOUT=5000

# Premier compte Direction (créé une seule fois, uniquement si aucun compte direction n'existe)
ECOLE_ADMIN_EMAIL=direction@exemple.td
ECOLE_ADMIN_MOT_DE_PASSE=CHANGER-moi-12-caracteres-minimum
ECOLE_ADMIN_NOM="Direction"

# Clé d'activation (peut aussi être saisie dans l'application, menu Licence)
# LICENCE_CLE_PUBLIQUE est déjà réglée par défaut dans config/licence.php
